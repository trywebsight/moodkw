APP_NAME="MOOD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moodkw
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Tap Payments (can also be configured in Admin > Settings)
# Leave blank locally — test keys are seeded into Admin > Settings via SettingSeeder
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_MODE=test
TAP_API_BASE=https://api.tap.company/v2

# Respond.io WhatsApp (can also be configured in Admin > Settings > WhatsApp)
RESPOND_BASE_URL=https://api.respond.io/v2
RESPOND_CHANNEL_ID=
RESPOND_CHANNEL_API_TOKEN=
RESPOND_PAYMENT_TEMPLATE=
RESPOND_PAYMENT_TEMPLATE_LANGUAGE=ar
